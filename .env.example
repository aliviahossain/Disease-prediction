# Development/Production Mode
FLASK_ENV=development  # Set to 'production' in production
FLASK_DEBUG=0          # Set to '1' for debug mode (development only)

# Security
SECRET_KEY=<your_secret_key_here>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Optional: Database
# By default everything (accounts, passwords, history) is stored in
# database/disease_prediction.db. Change the folder with DATABASE_DIR,
# or use an external database with DATABASE_URL.
# DATABASE_DIR=./database
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/disease_db